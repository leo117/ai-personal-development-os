# ============================================================
# 🤖 AI Personal Development OS - 环境变量配置文件
# ============================================================

# 1. 大模型 API 密钥 (必填项，若为空则自动回退为内置教学策略引擎)
# 兼容 OpenAI / DeepSeek / 智谱 GLM / 阿里通义千问 / SiliconFlow / Ollama 等
LLM_API_KEY=your_api_key_here

# 2. 大模型 API 接口地址 (默认为 OpenAI 官方，可替换为任意兼容代理)
# OpenAI 官方: https://api.openai.com/v1
# DeepSeek 官方: https://api.deepseek.com/v1
# 硅基流动: https://api.siliconflow.cn/v1
# 本地 Ollama: http://localhost:11434/v1
LLM_API_BASE=https://api.openai.com/v1

# 3. 模型名称
# e.g., gpt-4o, deepseek-chat, deepseek-coder, qwen-plus, glm-4, llama3
LLM_MODEL_NAME=gpt-4o

# 4. 模型生成温度与超时
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30

# 5. 数据库配置 (默认本地 SQLite，若有 PostgreSQL 可替换)
DATABASE_URL=sqlite:///./study_grow.db
